<script> 
document.getElementById("generate-pdf-btn").addEventListener("click", function (e) {
    e.preventDefault(); 

    const form = document.getElementById('main-druck-form');
    
    // Hilfsfunktion zum Auslesen der Vorschau-Werte
    const getVal = (id) => {
        const el = document.getElementById(id);
        if (!el) return '0.00';
        let val = el.innerText.replace('€', '').trim();
        return (val === '–' || val === '') ? '0.00' : val;
    };

    // Werte in die versteckten Felder kopieren
    document.getElementById('pdf-format').value      = getVal('preview-format');
    document.getElementById('pdf-grammatur').value   = getVal('preview-grammatur');
    document.getElementById('pdf-seitendruck').value = getVal('preview-seitendruck');
    document.getElementById('pdf-seiten').value      = getVal('preview-seiten');
    document.getElementById('pdf-farbseiten').value  = getVal('preview-farbseiten');
    document.getElementById('pdf-exemplare').value   = getVal('preview-exemplare');
    document.getElementById('pdf-einzelpreis').value = getVal('preview-einzelpreis');
    document.getElementById('pdf-gesamtpreis').value = getVal('preview-gesamtpreis');

    // Pfad zur PDF-Datei setzen
    const originalAction = form.action;
    form.action = '<?php echo plugin_dir_url(__FILE__); ?>pdf.php';
    form.target = '_blank';
    
    form.submit();

    // Formular für normalen Gebrauch zurücksetzen
    setTimeout(() => {
        form.action = originalAction;
        form.target = '_self';
    }, 500);
});
</script>